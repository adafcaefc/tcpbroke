# Copy to .env and fill in. .env is gitignored (contains secrets).
#
# These are the RELAY SERVER's settings - the container deployed to Azure Container Apps. Set them
# as environment variables on the Container App; the .env file itself is only for running the
# server locally (`docker run --env-file .env ...`).
#
# The CLIENT takes no env at all - the agent and listener are configured entirely by their flags.
# On the deploy VM those flags come from the forgejo repo's own .env (TUNNEL_RDP_*).

# --- Required ----------------------------------------------------------------
# Shared secret required on ALL THREE endpoints (/control, /listen, /stream/{id}). The server
# REFUSES TO START without it rather than quietly serving an unauthenticated path to a desktop.
#
# This is the only thing in front of RDP. Use a long random value (e.g. `openssl rand -hex 32`),
# and NEVER reuse the nbroke git-tunnel key. The same value goes in the forgejo repo's .env as
# TUNNEL_RDP_PASSWORD; rotate both together.
TUNNEL_KEY=PLACEHOLDER_GENERATE_A_LONG_RANDOM_VALUE

# --- Optional (defaults shown) -----------------------------------------------
# How long a viewer waits for the agent to dial back with its half of the stream.
STREAM_OPEN_TIMEOUT_SECONDS=15

# Release the single agent slot when its control socket has been silent this long. The agent pings
# every 30s, so silence means the socket died in a way TCP has not noticed (a half-open NAT/proxy
# state). Too high and a reconnecting agent is rejected as 'occupied' until this expires.
CONTROL_IDLE_TIMEOUT_SECONDS=180

# Per-IP failed-auth throttle: a delay on every failure, then a lockout after AUTH_FAIL_LIMIT
# failures inside AUTH_FAIL_WINDOW_SECONDS.
AUTH_FAIL_DELAY_SECONDS=1.0
AUTH_FAIL_LIMIT=5
AUTH_FAIL_WINDOW_SECONDS=300
AUTH_FAIL_BLOCK_SECONDS=900

# Take the client IP from X-Forwarded-For. Correct behind exactly one managed ingress (Container
# Apps). Set false if anything else can reach the server directly, or the header is spoofable and
# the per-IP lockout above becomes useless.
TRUST_FORWARDED_FOR=true

# Port uvicorn binds inside the container. Container Apps sets this itself; override only locally.
PORT=8000
